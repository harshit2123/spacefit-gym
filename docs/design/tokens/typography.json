{
  "_comment": "SpaceFit Typography Tokens — Barlow Condensed (display) + DM Sans (body) + Space Mono (mono)",

  "typography": {
    "fontFamilies": {
      "display": {
        "value": "'Barlow Condensed', 'Oswald', sans-serif",
        "weights": [600, 700, 800, 900],
        "googleFontsUrl": "https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700;800;900&display=swap",
        "usage": "Hero headlines, section titles, stat numbers, display text",
        "notes": "Condensed proportions amplify athletic impact at large scale. Use uppercase transforms for display sizes."
      },
      "body": {
        "value": "'DM Sans', 'Inter', sans-serif",
        "weights": [300, 400, 500, 600],
        "googleFontsUrl": "https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,300;9..40,400;9..40,500;9..40,600&display=swap",
        "usage": "Paragraphs, labels, form elements, navigation links, card descriptions, UI text",
        "notes": "Geometric humanist sans with excellent legibility on dark backgrounds at small sizes."
      },
      "mono": {
        "value": "'Space Mono', 'JetBrains Mono', monospace",
        "weights": [400, 700],
        "googleFontsUrl": "https://fonts.googleapis.com/css2?family=Space+Mono:wght@400;700&display=swap",
        "usage": "Stat counters, timestamps, metadata, code snippets, tracking IDs, data values",
        "notes": "Futuristic monospace that reinforces the SpaceFit space/tech brand identity."
      },
      "combined": {
        "googleFontsUrl": "https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700;800;900&family=DM+Sans:opsz,wght@9..40,300;9..40,400;9..40,500;9..40,600&family=Space+Mono:wght@400;700&display=swap"
